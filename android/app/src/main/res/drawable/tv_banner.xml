<?xml version="1.0" encoding="utf-8"?>
<!-- Leanback Favorite Apps tile (android:banner) — wide art; separate from launch splash. -->
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <item>
        <shape android:shape="rectangle">
            <solid android:color="#FF000000" />
        </shape>
    </item>
    <item
        android:bottom="12dp"
        android:left="20dp"
        android:right="20dp"
        android:top="12dp">
        <bitmap
            android:gravity="center"
            android:src="@drawable/tv_banner_logo" />
    </item>
</layer-list>
